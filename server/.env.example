# Postgres connection string. Fastest free option: https://neon.tech (no install, no credit card)
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/medrisk_lite"

# From your Clerk dashboard (Developers -> API Keys)
CLERK_SECRET_KEY="your_clerk_secret_key_here"
CLERK_PUBLISHABLE_KEY="your_clerk_publishable_key_here"

PORT=4000

# The frontend's origin, allowed by CORS. Matches "expo start --web" default.
APP_ORIGIN="http://localhost:8082"

# Optional: set this to upgrade all 4 AI features (AI Assistant "Roger", AI
# suggested failure modes, AI mitigation drafting, AI S-O-D scoring) from their
# free rule-based/static fallbacks to real Groq-hosted LLM calls. Leave unset to
# keep using the free fallbacks — no code changes needed either way. Get a free
# key at https://console.groq.com/keys.
# GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxx"

# Optional: override the Groq model used for the 4 AI features above. Defaults
# to "openai/gpt-oss-20b" (fast, on Groq's free tier). See
# https://console.groq.com/docs/models for what's currently available.
# GROQ_CHAT_MODEL="openai/gpt-oss-20b"

# TEMPORARY dev-only escape hatch: skips Clerk auth verification entirely,
# treating every request as one fixed dev user. Leave unset/false normally.
# BYPASS_AUTH=true

# Hardware sensor prototype (ESP32 + moisture/temperature sensors). The device
# authenticates with this key via the "x-device-key" header instead of Clerk.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HARDWARE_DEVICE_KEY="generate-a-long-random-string"

# Workspace ID that all hardware readings get bound to (multi-user app, but the
# physical device isn't tied to a logged-in user). Find your workspace ID via
# the Settings screen or `SELECT id, name FROM "Workspace"`.
HARDWARE_WORKSPACE_ID="your-workspace-id"
